FINSIGHT_DB_PORT=55432
FINSIGHT_DB_PASSWORD=replace-with-a-local-password
FINSIGHT_PUBLIC_DOMAIN=finsight.life

# Local backend secrets. Generate distinct 32-byte hex values.
# FINSIGHT_SIGNUP_CODE_KEY=
# FINSIGHT_APP_JWT_KEY=
# FINSIGHT_ADMIN_MFA_KEY=
# FINSIGHT_ADMIN_NOTE_KEY=
# FINSIGHT_ADMIN_PII_KEY=
# FINSIGHT_ADMIN_ORIGIN=https://localhost:18443
# FINSIGHT_ADMIN_PWNED_PASSWORDS=false
# FINSIGHT_EXPERIMENT_DIAGNOSIS_ENTRY_ENABLED=true
# FINSIGHT_POLICY_PREVIEW=true
# FINSIGHT_PASSWORD_RESET_LINK_ORIGIN=https://finsight.life
# FINSIGHT_IOS_APP_ID=
# FINSIGHT_NEWS_CANDIDATE_FILE=/absolute/path/to/news-candidates.json

# First local administrator only. Remove after the first successful startup.
# FINSIGHT_ADMIN_BOOTSTRAP=true
# FINSIGHT_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# FINSIGHT_BOOTSTRAP_ADMIN_PASSWORD=
# FINSIGHT_BOOTSTRAP_ADMIN_TOTP=

# Server console command only. Set for the recovery invocation.
# FINSIGHT_ADMIN_RECOVERY_ID=
# FINSIGHT_ADMIN_RECOVERY_REASON=

# Discord webhook credentials are server-only.
# FINSIGHT_DISCORD_ENABLED=false
# FINSIGHT_DISCORD_SIGNUP_WEBHOOK=
# FINSIGHT_DISCORD_WITHDRAWAL_WEBHOOK=
# FINSIGHT_DISCORD_SURVEY_WEBHOOK=
# FINSIGHT_DISCORD_NEWS_WEBHOOK=

# Keep external FCM disabled for local tests.
# FINSIGHT_FCM_ENABLED=false
# FINSIGHT_FCM_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=

# Keep the default local mailbox for development.
# FINSIGHT_MAIL_MODE=local
# FINSIGHT_MAILLINK_APP_KEY=
# FINSIGHT_MAILLINK_APP_SECRET=
# FINSIGHT_MAILLINK_SIGNUP_TEMPLATE=
# FINSIGHT_MAILLINK_RESET_TEMPLATE=

# Optional OAuth provider configuration. Keep client secrets on the server.
# FINSIGHT_SOCIAL_CALLBACK_ORIGIN=https://api.finsight.life
# FINSIGHT_SOCIAL_KAKAO_CLIENT_ID=
# FINSIGHT_SOCIAL_KAKAO_CLIENT_SECRET=
# FINSIGHT_SOCIAL_APPLE_CLIENT_ID=
# FINSIGHT_SOCIAL_APPLE_CLIENT_SECRET=
